  title = {A {{New Conical Regularization}} for {{Some Optimization}} and {{Optimal Control Problems}}: {{Convergence Analysis}} and {{Finite Element Discretization}}},
  shorttitle = {A {{New Conical Regularization}} for {{Some Optimization}} and {{Optimal Control Problems}}},
  author = {Khan, Akhtar A. and Sama, Miguel},
  year = {2013},
