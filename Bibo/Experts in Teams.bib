  file = {C\:\\Users\\paulschm\\Zotero\\storage\\2PDCD27G\\Nie und Yang - 2021 - The Multi-Objective Polynomial Optimization.pdf;C\:\\Users\\paulschm\\Zotero\\storage\\L5N5I4AE\\2108.html}
