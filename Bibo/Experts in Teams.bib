  doi = {10.48550/arXiv.1410.0136},
  url = {http://arxiv.org/abs/1410.0136},
  urldate = {2025-04-23},
  abstract = {Finite element approximations of Dirichlet boundary control problems governed by parabolic PDEs on convex polygonal domains are studied in this paper. The existence of a unique solution to optimal control problems is guaranteed based on very weak solution of the state equation and \$L{\textasciicircum}2(0,T;L{\textasciicircum}2({\textbackslash}Gamma))\$ as control space. For the numerical discretization of the state equation we use standard piecewise linear and continuous finite elements for the space discretization of the state, while a dG(0) scheme is used for time discretization. The Dirichlet boundary control is realized through a space-time \$L{\textasciicircum}2\$-projection. We consider both piecewise linear, continuous finite element approximation and variational discretization for the controls and derive a priori \$L{\textasciicircum}2\$-error bounds for controls and states. We finally present numerical examples to support our theoretical findings.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Optimization and Control},
  file = {C\:\\Users\\paulschm\\Zotero\\storage\\HI72MCJH\\Gong et al. - 2014 - A finite element method for Dirichlet boundary control problems governed by parabolic PDEs.pdf;C\:\\Users\\paulschm\\Zotero\\storage\\3PSUTMII\\1410.html}
}

@article{GustafssonRonnqvist2008OptimalheatinglargeblockflatsjournalArticle,
